@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container py-5 ctrl-manage-shell">
    <div class="row g-4">

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0 ctrl-manage-card">
                <div class="card-body ctrl-manage-nav">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9">
            @RenderBody()
        </div>

    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}