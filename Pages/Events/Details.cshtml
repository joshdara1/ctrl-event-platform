@page "{id:int?}"
@model CTRL.Pages.Events.DetailsModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-5">

    <div class="card shadow-lg border-0">

        <img src="@(string.IsNullOrWhiteSpace(Model.Event.ImageUrl) ? "https://via.placeholder.com/1200x500?text=CTRL+Event" : Model.Event.ImageUrl)"
             class="card-img-top"
             alt="@Model.Event.Title"
             style="max-height: 450px; object-fit: cover;" />

        <div class="card-body p-4">

            <span class="badge bg-dark mb-3">
                @Model.Event.Category
            </span>

            <h1 class="fw-bold mb-3">
                @Model.Event.Title
            </h1>

            <p class="text-muted mb-2">
                <strong>Date:</strong>
                @Model.Event.Date.ToString("dd MMM yyyy")
            </p>

            <p class="text-muted mb-2">
                <strong>Venue:</strong>
                @Model.Event.Venue
            </p>

            <p class="text-muted mb-2">
                <strong>Price:</strong>
                £@Model.Event.TicketPrice
            </p>

            @if (Model.Event.DJ != null)
            {
                <p class="text-muted mb-2">
                    <strong>DJ:</strong>
                    @Model.Event.DJ.Name
                </p>
            }

            <hr />

            <p class="mb-4">
                @Model.Event.Description
            </p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if (Model.IsRegistered)
                {
                    <div class="alert alert-success">
                        You are already registered for this event.
                    </div>

                    <form method="post" asp-page-handler="Unregister">
                        <input type="hidden"
                               name="id"
                               value="@Model.Event.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger btn-lg">
                            Unregister
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Attend">
                        <input type="hidden"
                               name="id"
                               value="@Model.Event.Id" />

                        <button type="submit"
                                class="btn btn-dark btn-lg">
                            Attend Event
                        </button>
                    </form>
                }
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-dark btn-lg">

                    Log in to attend

                </a>
            }

        </div>

    </div>

</div>