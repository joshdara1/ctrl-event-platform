@page
@model CTRL.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Events";

    var canManageEvents =
        User.Identity != null &&
        User.Identity.IsAuthenticated &&
        (User.IsInRole("Admin") || User.IsInRole("Organiser"));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Upcoming Events</h1>
        <p class="text-muted mb-0">
            Discover and manage events on CTRL
        </p>
    </div>

    @if (canManageEvents)
    {
        <a asp-page="Create"
           class="btn btn-dark">
            + Create Event
        </a>
    }
</div>

<form method="get" class="mb-4">
    <div class="row g-2">

        <div class="col-md-10">
            <input asp-for="SearchTerm"
                   class="form-control"
                   placeholder="Search events..." />
        </div>

        <div class="col-md-2 d-grid">
            <button type="submit"
                    class="btn btn-outline-dark">
                Search
            </button>
        </div>

    </div>
</form>

@if (Model.Event == null || Model.Event.Count == 0)
{
    <div class="alert alert-info">
        No events found.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model.Event)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm border-0 position-relative ctrl-hover-card">

                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? "https://via.placeholder.com/600x300?text=CTRL+Event"
                        : item.ImageUrl)"
                         class="card-img-top"
                         alt="@item.Title"
                         style="height:220px; object-fit:cover;" />

                    <div class="card-body">

                        <span class="badge bg-dark mb-2">
                            @item.Category
                        </span>

                        <h5 class="card-title fw-bold">
                            @item.Title
                        </h5>

                        @if (item.DJ != null)
                        {
                            <p class="text-muted mb-2">
                                DJ: <strong>@item.DJ.Name</strong>
                            </p>
                        }

                        <p class="card-text text-muted mb-2">
                            @item.Description
                        </p>

                        <p class="mb-1">
                            <strong>Date:</strong>
                            @item.Date.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-1">
                            <strong>Venue:</strong>
                            @item.Venue
                        </p>

                        <p class="mb-3">
                            <strong>Price:</strong>
                            £@item.TicketPrice
                        </p>

                        <!-- whole card clickable -->
                        <a asp-page="./Details"
                           asp-route-id="@item.Id"
                           class="stretched-link"
                           aria-label="View details for @item.Title">
                        </a>

                        <div class="d-flex gap-2 flex-wrap position-relative"
                             style="z-index:2;">

                            <a asp-page="./Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-dark btn-sm">
                                Details
                            </a>

                            @if (canManageEvents)
                            {
                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}