<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "CTRL")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CTRL.styles.css" asp-append-version="true" />
</head>

<body>

<header>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

<div class="container-fluid px-4 px-md-5">

<a class="navbar-brand" asp-area="" asp-page="/Index">
<img src="~/images/ctrl-logo.png" height="40" />
</a>

<button class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarMain">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse justify-content-end" id="navbarMain">

<ul class="navbar-nav">

<li class="nav-item">
<a class="nav-link" asp-page="/Index">Home</a>
</li>

<li class="nav-item">
<a class="nav-link" asp-page="/Events/Index">Events</a>
</li>

<li class="nav-item">
<a class="nav-link" asp-page="/DJs/Index">DJs</a>
</li>

<li class="nav-item">
<a class="nav-link" asp-page="/Privacy">Privacy</a>
</li>

</ul>

<partial name="_LoginPartial" />

</div>

</div>

</nav>

</header>


<div class="container-fluid px-4 px-md-5">

<main role="main" class="pb-3">

@RenderBody()

</main>

</div>


<footer class="border-top footer text-muted mt-5">

<div class="container-fluid px-4 px-md-5">

&copy; 2026 - CTRL

</div>

</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>