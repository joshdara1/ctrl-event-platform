@page
@model PrivacyModel

@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow-lg border-0">

<div class="card-body p-5">

<h1 class="fw-bold mb-4">
Privacy Policy
</h1>

<p class="lead">
CTRL values your privacy and is committed to protecting
the information you provide when using the platform.
</p>

<hr class="my-4">

<h4>Information We Collect</h4>

<p>
When creating an account or using CTRL,
we may collect information including:
</p>

<ul>
<li>Email address</li>
<li>Account login information</li>
<li>Event registration activity</li>
<li>User profile information submitted through the platform</li>
</ul>


<h4 class="mt-4">
How We Use Information
</h4>

<p>
Information collected is used to:
</p>

<ul>
<li>Provide access to user accounts</li>
<li>Support event registration and ticket confirmations</li>
<li>Manage platform features and user interactions</li>
<li>Improve the functionality of the platform</li>
</ul>


<h4 class="mt-4">
Data Protection
</h4>

<p>
CTRL uses secure authentication and access controls
to help protect account information
and restrict unauthorised access.
</p>


<h4 class="mt-4">
Data Sharing
</h4>

<p>
Personal information is not sold or shared
with third parties.
</p>


<h4 class="mt-4">
User Control
</h4>

<p>
Users may manage their account information
through the account settings available within the platform.
</p>


<h4 class="mt-4">
Contact
</h4>

<p>
For questions regarding privacy or account data,
please contact the platform administrator.
</p>

</div>

</div>

</div>

</div>

</div>